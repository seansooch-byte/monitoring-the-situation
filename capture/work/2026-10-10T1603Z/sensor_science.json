/img/EXyO1wWujYI9tOhF.jpg","type":"video","width":1080},{"height":1440,"media_key":"3_2108931791436304384","type":"photo","url":"https://pbs.twimg.com/media/HURuSmwW0AAHWL7.jpg","width":1080},{"duration_ms":26960,"height":2160,"media_key":"13_2108825189471387648","preview_image_url":"https://pbs.twimg.com/amplify_video_thumb/2108825189471387648/img/k04-BcanYRHHZiWE.jpg","type":"video","width":3840},{"height":1612,"media_key":"3_2108926659172638720","type":"photo","url":"https://pbs.twimg.com/media/HURpn3lWIAA6jvU.jpg","width":2386},{"height":372,"media_key":"3_2108926666722426880","type":"photo","url":"https://pbs.twimg.com/media/HURpoTtWwAASTyd.jpg","width":752}],"tweets":[{"attachments":{"media_keys":["13_2108950248613662721"]},"author_id":"1907894348319973378","created_at":"2026-10-10T16:00:18.000Z","edit_history_tweet_ids":["2108950762994741523"],"id":"2108950762994741523","public_metrics":{"bookmark_count":1,"impression_count":7754,"like_count":43,"quote_count":0,"reply_count":1,"retweet_count":11},"text":"NASA’s mission reached across the planet and beyond this week 🚀\n\n❄️ Inspiration Tour heads to Alaska\n🌎 NASA leads at IAC in Antalya\n🧑‍🚀 Crew-12 returns home\n🌕 Artemis II science data released\n\nHere’s what's new in your NASA Minute! https://t.co/2RzkW9OwCS"},{"article":{"title":"Models as Insider Risks in the Super Intelligence Era "},"author_id":"20571756","created_at":"2026-10-10T14:43:10.000Z","edit_history_tweet_ids":["2108931348857827686"],"id":"2108931348857827686","public_metrics":{"bookmark_count":850,"impression_count":370200,"like_count":1095,"quote_count":123,"reply_count":201,"retweet_count":141},"text":"https://t.co/MjwFy73LOF"},{"attachments":{"media_keys":["13_2108644996249444354"]},"author_id":"505835394","created_at":"2026-10-09T19:45:22.000Z","edit_history_tweet_ids":["2108645012644991251"],"id":"2108645012644991251","public_metrics":{"bookmark_count":634,"impression_count":106070,"like_count":941,"quote_count":6,"reply_count":59,"retw