nced_tweets":[{"id":"2110348069141086693","type":"retweeted"}],"text":"RT @charliebilello: Price changes over last year (September CPI report)\nFuel Oil: +74.0%\nGasoline: +34.2%\nGas Utilities: +5.0%\nElectricity:…","url":"https://x.com/GPerspective_X/status/2110355552652185617"}],"includes":{"tweets":[{"author_id":"2704294333","conversation_id":"2110347514683490356","created_at":"2026-10-14T12:30:30.000Z","edit_history_tweet_ids":["2110347514683490356"],"id":"2110347514683490356","lang":"en","note_tweet":{"text":"U.S. INFLATION SURGES TO 3.7%, BEATING EXPECTATIONS\n\nSeptember CPI rose 0.6% MoM, matching forecasts, while annual inflation hit 3.7% vs. 3.6% expected.\n\nCore CPI climbed 0.3% vs. 0.2% expected, with annual core inflation reaching 2.6% vs. 2.5% forecast.\n\nGasoline prices surged 9.1%, energy jumped 5.2%, and real earnings fell 0.5%, highlighting renewed pressure on consumers."},"possibly_sensitive":false,"public_metrics":{"bookmark_count":48,"impression_count":131529,"like_count":770,"quote_count":61,"reply_count":63,"retweet_count":141},"text":"U.S. INFLATION SURGES TO 3.7%, BEATING EXPECTATIONS\n\nSeptember CPI rose 0.6% MoM, matching forecasts, while annual inflation hit 3.7% vs. 3.6% expected.\n\nCore CPI climbed 0.3% vs. 0.2% expected, with annual core inflation reaching 2.6% vs. 2.5% forecast.\n\nGasoline prices surged"},{"author_id":"3316376038","conversation_id":"2110347809308455363","created_at":"2026-10-14T12:31:40.000Z","edit_history_tweet_ids":["2110347809308455363"],"id":"2110347809308455363","lang":"en","possibly_sensitive":false,"public_metrics":{"bookmark_count":116,"impression_count":140013,"like_count":1772,"quote_count":91,"reply_count":145,"retweet_count":307},"text":"BREAKING: September CPI inflation rises to 3.7%, above expectations of 3.6%\n\nCore CPI inflation rises to 2.6%, also above expectations of 2.5%.\n\nThis officially marks the third highest US inflation reading since September 2023.\n\nRate hike expectations are rising on the news."},{"author_id":"2704294333","conversation_id":"2110349054815174737","created_at":"2026-10-14T12:36:37.000Z","edit_history_tweet_ids":["2110349054815174737"],"id":"2110349054815174737","lang":"en","note_tweet":{"text":"U.S. INFLATION RUNS HOTTER THAN HEADLINE NUMBERS SUGGEST\n\nUnrounded September CPI rose 0.649% MoM, beating the 0.58% forecast, while core CPI climbed 0.335% vs. 0.21% expected.\n\nAnnual inflation reached 3.738%, with core CPI accelerating to 2.564% from 2.446%.\n\nBoth headline and core inflation exceeded expectations."},"possibly_sensitive":false,"public_metrics":{"bookmark_count":22,"impression_count":74100,"like_count":303,"quote_count":16,"reply_count":25,"retweet_count":63},"text":"U.S. INFLATION RUNS HOTTER THAN HEADLINE NUMBERS SUGGEST\n\nUnrounded September CPI rose 0.649% MoM, beating the 0.58% forecast, while core CPI climbed 0.335% vs. 0.21% expected.\n\nAnnual inflation reached 3.738%, with core CPI accelerating to 2.564% from 2.446%.\n\nBoth headline and"},{"author_id":"87241834","conversation_id":"2110265624412696921","created_at":"2026-10-14T07:05:06.000Z","edit_history_tweet_ids":["2110265624412696921"],"entities":{"hashtags":[{"end":212,"start":208,"tag":"Oil"},{"end":222,"start":213,"tag":"Gasoline"},{"end":233,"start":223,"tag":"Inflation"},{"end":238,"start":234,"tag":"CPI"}],"urls":[{"description":"Surging energy prices are expected to drive U.S. inflation higher in September, increasing financial pressure on American households.","display_url":"oilprice.com/Latest-Energy-…","end":263,"expanded_url":"https://oilprice.com/Latest-Energy-News/World-News/Rising-Gasoline-Prices-Fuel-Fresh-Inflation-Fears-in-the-US.html","images":[{"height":563,"url":"https://pbs.twimg.com/news_img/2110262074400198656/WicjU-cZ?format=jpg&name=orig","width":1000},{"height":150,"url":"https://pbs.twimg.com/news_img/2110262074400198656/WicjU-cZ?format=jpg&name=150x150","width":150}],"start":240,"status":200,"title":"Rising Gasoline Prices Fuel Fresh Inflation Fears in the U.S. | OilPrice.com","unwound_url":"https://oilprice.com/Latest-Energy-News/World-News/Rising-Gasoline-Prices-Fuel-Fresh-Inflation-Fears-in-the-US.html","url":"https://t.co/43q8pPMwJe"}]},"id":"2110265624412696921","lang":"en","possibly_sensitive":false,"public_metrics":{"bookmark_count":1,"impression_count":2918,"like_count":25,"quote_count":1,"reply_count":1,"retweet_count":7},"text":"U.S. gasoline jumped 7.1% last month to an AAA average of $4.3413 a gallon, and economists see September CPI up 0.6% m/m as energy costs lift inflation higher. Annual CPI sits at 3.6% vs the Fed's 2% target. #Oil #Gasoline #Inflation #CPI\n\nhttps://t.co/43q8pPMwJe"},{"author_id":"1413027896","conversation_id":"2110348069141086693","created_at":"2026-10-14T12:32:42.000Z","edit_history_tweet_ids":["2110348069141086693"],"id":"2110348069141086693","lang":"en","note_tweet":{"text":"Price changes over last year (September CPI report)\nFuel Oil: +74.0%\nGasoline: +34.2%\nGas Utilities: +5.0%\nElectricity: +4.4%\nOverall CPI: +3.7%\nFood away from home: +3.5%\nApparel: +3.4%\nShelter: +3.2%\nTransportation: +2.7%\nMedical Care: +2.5%\nFood at home: +1.8%\nNew Cars: +0.6% \nUsed Cars: -1.5%"},"possibly_sensitive":false,"public_metrics":{"bookmark_count":15,"impression_count":16132,"like_count":120,"quote_count":6,"reply_count":16,"retweet_count":48},"text":"Price changes over last year (September CPI report)\nFuel Oil: +74.0%\nGasoline: +34.2%\nGas Utilities: +5.0%\nElectricity: +4.4%\nOverall CPI: +3.7%\nFood away from home: +3.5%\nApparel: +3.4%\nShelter: +3.2%\nTransportation: +2.7%\nMedical Care: +2.5%\nFood at home: +1.8%\nNew Cars: +0.6%"},{"attachments":{"media_keys":["13_2110355512743096320"]},"author_id":"1549498377213054976","conversation_id":"2110354459674951868","created_at":"2026-10-14T13:02:29.000Z","edit_history_tweet_ids":["2110355562974138761"],"entities":{"mentions":[{"end":10,"id":"18856867","start":0,"username":"zerohedge"}],"urls":[{"display_url":"pic.x.com/G7UkCVHYSN","end":311,"expanded_url":"https://x.com/kautiousCo/status/2110355562974138761/video/1","media_key":"13_2110355512743096320","start":288,"url":"https://t.co/G7UkCVHYSN"}]},"id":"2110355562974138761","lang":"en","note_tweet":{"text":"September CPI came in at 3.7% year over year, up from 3.4% in August. Prices rose 0.6% in the month.\n\nGasoline explains most of that jump. But the core inflation number is why this report is harder to shrug off.\n\nGas prices surged 9.1% in September and accounted for more than half the monthly CPI increase. Energy overall rose 5.2%.\n\nThat matters for household budgets, but energy prices are volatile. A gasoline-driven spike tells us less about persistent inflation than a sustained rise across other goods and services.\n\nThe disappointment was core CPI, which excludes food and energy:\n\n• Monthly: 0.3%, versus 0.2% expected\n• Yearly: 2.6%, up from 2.4% in August\nCore didn't accelerate month over month. It stayed at August's 0.3% pace. The problem is that economists expected it to cool, and it didn't.\n\nThere was also enough pressure outside energy to warrant attention. Core goods rose 0.3%, compared with 0.1% in August. Services excluding energy rose 0.4%, versus 0.3%.\n\nUsed cars were up 0.7%, airfares 1.2%, and recreation 0.5%.\n\nShelter increased 0.4%, although the details were less alarming than that headline might suggest: rent rose 0.2%, owners' equivalent rent 0.3%, and lodging away from home jumped 2.0%. Residential rents weren't all suddenly rising at the same pace.\n\nFood was a bright spot. Grocery prices fell 0.1%, and overall food prices were flat.\n\nMy read: the energy shock explains the big headline number, while the core print gives the Fed less reassurance that underlying inflation is settling down.\n\nThat strengthens the argument for keeping policy restrictive. If markets respond by pricing higher rates, it would generally support the dollar and pressure bonds and expensive growth stocks. That's a potential transmission mechanism, not a claim about the market's actual reaction.\n\nThis report doesn't make another rate hike inevitable. It also doesn't prove that energy inflation is spreading through the economy.\n\nIt does show that the hoped-for slowdown in core inflation didn't arrive. Calling the entire report “just gasoline” misses that."},"possibly_sensitive":false,"public_metrics":{"bookmark_count":0,"impression_count":21,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":1},"referenced_tweets":[{"id":"2110354459674951868","type":"replied_to"}],"text":"@zerohedge September CPI came in at 3.7% year over year, up from 3.4% in August. Prices rose 0.6% in the month.\n\nGasoline explains most of that jump. But the core inflation number is why this report is harder to shrug off.\n\nGas prices surged 9.1% in September and accounted for more than https://t.co/G7UkCVHYSN"}],"users":[{"created_at":"2010-01-28T02:55:19.000Z","description":"東京スワローズの偽ファンです。神宮球場によく晩ご飯を食べにでかけます。 フォロー/アンフォローはご自由に！ フォロバはしていませんので悪しからず。","id":"109141119","location":"明治神宮球場","name":"𝙠𝙞𝙯𝙪𝙠𝙖","public_metrics":{"followers_count":881,"following_count":44,"like_count":48752,"listed_count":21,"media_count":3428,"tweet_count":224369},"username":"_kyzka","verified":false,"verified_type":"none"},{"created_at":"2013-12-26T20:42:52.000Z","description":"In $SNEK we trust.","id":"2245374755","name":"KezMaDoom","public_metrics":{"followers_count":377,"following_count":1742,"like_count":5860,"listed_count":0,"media_count":1,"tweet_count":1179},"username":"DitryFoomin1","verified":false,"verified_type":"none"},{"created_at":"2025-02-22T17:17:22.000Z","description":"Life is the one way trip without return ticket!","id":"1893349299632652288","name":"御风 Free like the wind 🥰","public_metrics":{"followers_count":46,"following_count":48,"like_count":3658,"listed_count":0,"media_count":3,"tweet_count":3390},"username":"Goldone589","verified":false,"verified_type":"none"},{"crea