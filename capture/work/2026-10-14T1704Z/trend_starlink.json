:"2026-10-14T11:16:12.000Z","edit_history_tweet_ids":["2110328818271768882"],"id":"2110328818271768882","public_metrics":{"bookmark_count":5,"impression_count":2480,"like_count":201,"quote_count":9,"reply_count":17,"retweet_count":93},"text":"Feds took over railroads, phones, and banks.\nStarlink is next. https://t.co/ZzPMULkTZY"},{"attachments":{"media_keys":["13_2110286379192360960"]},"author_id":"105213189","created_at":"2026-10-14T08:27:57.000Z","edit_history_tweet_ids":["2110286474159464566"],"id":"2110286474159464566","public_metrics":{"bookmark_count":134,"impression_count":104494,"like_count":1763,"quote_count":20,"reply_count":20,"retweet_count":294},"text":"#BREAKING \n\n“I am significantly ahead of him in the queue”\n\nSunil Bharti Mittal responds to Elon Musk’s Starlink tweet, saying he applied for approvals five years ago, his ground network has been ready for three years and his satellites have been over India for five years, yet https://t.co/OTKYIQdYcu"},{"attachments":{"media_keys":["3_2110263587264516096","3_2110263599625109505"]},"author_id":"1347476208703909888","created_at":"2026-10-14T06:57:06.000Z","edit_history_tweet_ids":["2110263612438700445"],"id":"2110263612438700445","public_metrics":{"bookmark_count":359,"impression_count":232437,"like_count":8293,"quote_count":188,"reply_count":574,"retweet_count":1770},"text":"🇺🇸🇺🇦Panic in Ukraine as Starlink restricts operations - Zelensky has only Ursula left to guide his missiles.\n\nAccording to Ukrainian media, Elon Musk's Starlink restricted operations in Ukraine overnight, disrupting Ukrainian attacks on Russian territory.\n\nUkrainian officials and https://t.co/uxV8uayCpc"},{"author_id":"1487153601231343618","created_at":"2026-10-14T06:13:39.000Z","edit_history_tweet_ids":["2110252678194328042"],"id":"2110252678194328042","public_metrics":{"bookmark_count":293,"impression_count":319483,"like_count":4462,"quote_count":130,"reply_count":206,"retweet_count":1037},"text":"I confirm that tonight SpaceX introduced a speed restriction on Starlink terminals while in motion.\nAt present, the restriction applies to the StarShield “military package” and is set at 100 miles per hour.\nOur Defense Forces received no prior warning about this limitation, which"},{"attachments":{"media_keys":["3_2110341250654101505"]},"author_id":"1457867047334031360","created_at":"2026-10-14T12:05:45.000Z","edit_history_tweet_ids":["2110341286049784195"],"id":"2110341286049784195","public_metrics":{"bookmark_count":140,"impression_count":153989,"like_count":1751,"quote_count":51,"reply_count":160,"retweet_count":237},"text":"Ukraine says SpaceX has put new speed limits on military grade Starlink terminals without warning, disrupting some missions, according to multiple outlets. SpaceX hasn’t commented.\n\nThe affected service is StarShield, a Starlink subscription for government and military use. The https://t.co/874mnNcZXC"},{"author_id":"1537130875296563200","created_at":"2026-10-14T07:31:56.000Z","edit_history_tweet_ids":["2110272376596213765"],"id":"2110272376596213765","public_metrics":{"bookmark_count":169,"impression_count":80036,"like_count":7824,"quote_count":55,"reply_count":130,"retweet_count":2092},"referenced_tweets":[{"id":"2110271119278440913","type":"quoted"}],"text":"Exactly. Once Musk gets your nation reliant on starlink, he can cut your defenses, communications, or anything else you've spent years and billions building upon it.\n\nAs we see this morning with Ukraine. https://t.co/w7fH1QQltw"},{"attachments":{"media_keys":["3_2110392319467806720"]},"author_id":"198814483","created_at":"2026-10-14T15:30:03.000Z","edit_history_tweet_ids":["2110392699207680136"],"id":"2110392699207680136","in_reply_to_user_id":"829647236","public_metrics":{"bookmark_count":0,"impression_count":126,"like_count":3,"quote_count":0,"reply_count":0,"retweet_count":1},"referenced_tweets":[{"id":"2110351406708470131","type":"replied_to"}],"text":"@pmakela1 It is  a long way to the top (Gemini trawled). \nThe thing is that Starlink not only got a head-start, but the financial muscles are enormous. https://t.co/mrFhtiYKSu"},{"author_id":"861014238416048129","created_at":"2026-10-14T08:56:04.000Z","edit_history_tweet_ids":["2110293549782851667"],"id":"2110293549782851667","public_metrics":{"bookmark_count":81,"impression_count":36381,"like_count":1574,"quote_count":9,"reply_count":95,"retweet_count":560},"referenced_tweets":[{"id":"2110276531948011620","type":"quoted"}],"text":"To all the Starlink fans &amp; promoters in 🇿🇦 and elsewhere 👇🏼 https://t.co/oT4S1UQXxY"},{"author_id":"17133897","created_at":"2026-10-14T08:10:48.000Z","edit_history_tweet_ids":["2110282160242610198"],"id":"2110282160242610198","public_metrics":{"bookmark_count":123,"impression_count":123038,"like_count":6569,"quote_count":77,"reply_count":267,"retweet_count":1155},"text":"The Starlink restriction over Ukraine is a perfect illustration of the danger of relying on US technology. Finding alternatives that aren’t Chinese is difficult and expensive- but I expect the drive to accelerate"},{"author_id":"573699122","created_at":"2026-10-14T13:05:32.000Z","edit_history_tweet_ids":["2110356332029096365"],"id":"2110356332029096365","public_metrics":{"bookmark_count":0,"impression_count":739,"like_count":26,"quote_count":0,"reply_count":37,"retweet_count":0},"referenced_tweets":[{"id":"2110345925000364168","type":"quoted"}],"text":"If you own Starlink, cancel it. I am. https://t.co/maPFL5EZQh"},{"author_id":"1556928681364361216","created_at":"2026-10-14T11:57:58.000Z","edit_history_tweet_ids":["2110339327951564896"],"id":"2110339327951564896","public_metrics":{"bookmark_count":20,"impression_count":34577,"like_count":2468,"quote_count":26,"reply_count":517,"retweet_count":329},"text":"So the US has limited Starlink use for Ukraine even tho Ukraine did not attack Russian oil refineries as they asked? What the hell esle do they want from us? To surrender?"},{"attachments":{"media_keys":["3_2110374114108260352"]},"author_id":"1818311005698678784","created_at":"2026-10-14T14:16:15.000Z","edit_history_tweet_ids":["2110374125659410865"],"id":"2110374125659410865","public_metrics":{"bookmark_count":94,"impression_count":132878,"like_count":1154,"quote_count":17,"reply_count":104,"retweet_count":165},"text":"SpaceX uses ARGON ION PROPULSION to move Starlink satellites through space \n\nAnd the engineering is pretty wild\n\nStarlink satellites use argon Hall-effect thrusters  electric engines that ionize argon gas and accelerate the charged particles at extremely high speed\n\nThey allow https://t.co/zixoqdoTdz"},{"author_id":"1073047860260814848","created_at":"2026-10-14T12:58:48.000Z","edit_history_tweet_ids":["2110354638054494702"],"id":"2110354638054494702","public_metrics":{"bookmark_count":18,"impression_count":12048,"like_count":1932,"quote_count":8,"reply_count":18,"retweet_count":561},"text":"In 2022 Musk turned off Starlink at Kremlin’s request to prevent a Ukrainian surprise drone attack on Russian Black Sea fleet near Sevastopol in occupied-Crimea. Russian ships went on to murder many innocent civilians. Elon has always been Putin’s bitch. VOTE Blue."},{"author_id":"901453070223249409","created_at":"2026-10-14T16:49:02.000Z","edit_history_tweet_ids":["2110412577696018895"],"id":"2110412577696018895","in_reply_to_user_id":"109749447","public_metrics":{"bookmark_count":0,"impression_count":49,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":1},"referenced_tweets":[{"id":"2110361293555474720","type":"replied_to"}],"text":"@JoeyContino @Starlink @elonmusk Elon or SpaceX does not control Star shield. Thats the domain of space force and the US government.\n\nYou're cancelling based on complete ignorance, and announcing it loud and proud."},{"author_id":"1629553239057403905","created_at":"2026-10-14T08:36:29.000Z","edit_history_tweet_ids":["2110288623971221511"],"id":"2110288623971221511","public_metrics":{"bookmark_count":72,"impression_count":